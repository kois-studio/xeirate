{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "files": {
        "includes": ["biome.json", "package.json", "tsconfig.json", "astro.config.mjs", "src/**/*"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "vcs": {
        "useIgnoreFile": true
    }
}
