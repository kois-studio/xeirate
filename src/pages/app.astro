---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this component in the template.
import WorkspaceApp from '../components/WorkspaceApp';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#dff3e8" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="Xeirate" />
		<meta
			name="description"
			content="Workspace local de Xeirate para preparar sesiones mensuales de guardias."
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Xeirate · Tu espacio de guardias</title>
	</head>
	<body>
		<header class="site-header app-site-header">
			<a class="brand" href="../" aria-label="Xeirate, inicio">
				<span class="brand-mark" aria-hidden="true">x</span>
				<span>xeirate</span>
			</a>
			<a class="privacy-pill app-help-link" href="../#como-funciona">Cómo funciona <span aria-hidden="true">↗</span></a>
		</header>

		<main>
			<WorkspaceApp client:load />
		</main>

		<footer class="site-footer">
			<span>Todo se guarda en este navegador.</span>
			<a class="text-link" href="../">Volver a la presentación</a>
		</footer>
	</body>
</html>
